<!DOCTYPE html>
<html lang="en">
<head>
    <title>Toggle Key</title>
    <script src="/vue.global.js"></script>
</head>
<body>
    <div id="app">
        <button @click="show = !show">Toggle</button>
        <h1 v-show="show">Toggle Key</h1>
    </div>

    <script>
        const { createApp } = Vue;
        createApp({
            data() {
                return {
                    show: true
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
