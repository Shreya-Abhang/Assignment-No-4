<!DOCTYPE html>
<html>
<head>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
</head>
<body>
    <div id="app">
        <input v-model="message" placeholder="Type something..." />
        <p>{{ message }}</p>
    </div>

    <script>
        const { createApp, ref } = Vue;
        createApp({
            setup() {
                const message = ref('Hello');
                return {
                    message
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
