<!DOCTYPE html>
<html>
<head>
    <title>Increment & Decrement</title>
    <script src="/vue.global.js"></script>
</head>
<body>
    <div id="app">
        <button @click="count++">Increment</button>
        <button @click="count--">Decrement</button>
        <p>{{ count }}</p>
    </div>

    <script>
        const { createApp } = Vue;
        createApp({
            data() {
                return {
                    count: 0
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
