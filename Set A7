<!DOCTYPE html>
<html>
<head>
    <title>Form with v-model</title>
    <script src="/vue.global.js"></script>
</head>
<body>
    <div id="app">
        <input type="text" v-model.trim="name" placeholder="Enter Your name" />
        <p>Name: {{ name }}</p>

        <input type="number" v-model.number="age" placeholder="Enter your age" />
        <p>Age: {{ age }}</p>
    </div>

    <script>
        const { createApp } = Vue;
        createApp({
            data() {
                return {
                    name: "",
                    age: null
                };
            }
        }).mount('#app');
    </script>
</body>
</html>
